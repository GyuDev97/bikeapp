<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8F5"
    android:fillViewport="true"
    android:overScrollMode="never">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="720dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <View
            android:id="@+id/login_accent"
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:layout_marginTop="64dp"
            android:background="@drawable/auth_logo_bg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/login_logo_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="TrailGO"
            android:src="@drawable/profile_ic_bicycle"
            android:tint="#FFFFFF"
            app:layout_constraintBottom_toBottomOf="@id/login_accent"
            app:layout_constraintEnd_toEndOf="@id/login_accent"
            app:layout_constraintStart_toStartOf="@id/login_accent"
            app:layout_constraintTop_toTopOf="@id/login_accent" />

        <TextView
            android:id="@+id/login_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="TrailGO"
            android:textColor="#16251B"
            android:textSize="36sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/login_accent" />

        <TextView
            android:id="@+id/login_tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="모든 순간이, 나의 트레일"
            android:textColor="#6B746E"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/login_brand" />

        <LinearLayout
            android:id="@+id/login_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="38dp"
            android:background="@drawable/auth_card_bg"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="22dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/login_tagline">

            <TextView
                android:id="@+id/textView5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="다시 만나 반가워요"
                android:textColor="#182019"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="로그인하고 오늘의 라이딩을 시작하세요."
                android:textColor="#747C76"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="아이디"
                android:textColor="#303832"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/userid"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/auth_input_bg"
                android:hint="아이디를 입력해주세요"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#182019"
                android:textColorHint="#A0A6A1"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="비밀번호"
                android:textColor="#303832"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/userpw"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/auth_input_bg"
                android:hint="비밀번호를 입력해주세요"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#182019"
                android:textColorHint="#A0A6A1"
                android:textSize="15sp" />

            <Button
                android:id="@+id/login_bt"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="26dp"
                android:background="@drawable/auth_primary_button"
                android:stateListAnimator="@null"
                android:text="로그인"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#E5E9E5" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:text="처음이신가요?"
                    android:textColor="#929892"
                    android:textSize="12sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#E5E9E5" />
            </LinearLayout>

            <Button
                android:id="@+id/join"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/auth_secondary_button"
                android:stateListAnimator="@null"
                android:text="회원가입"
                android:textAllCaps="false"
                android:textColor="#1B5E20"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/guest_start"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/auth_secondary_button"
                android:stateListAnimator="@null"
                android:text="비회원으로 시작하기"
                android:textAllCaps="false"
                android:textColor="#4E5A51"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:gravity="center"
                android:text="주행 기록은 이 기기에만 저장됩니다."
                android:textColor="#929892"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="30dp"
            android:text="안전하고 즐거운 라이딩을 TrailGO와 함께"
            android:textColor="#9AA09B"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/login_card" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
