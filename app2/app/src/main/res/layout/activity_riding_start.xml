<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/default_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8F7"
    android:fitsSystemWindows="true"
    tools:context=".ui.riding.StartActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/riding_header"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:background="#FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/gps_status"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/riding_gps_chip"
            android:drawableStart="@drawable/riding_ic_pin"
            android:drawablePadding="6dp"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="GPS 연결 중"
            android:textColor="#237A35"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/riding_settings_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:clickable="true"
            android:contentDescription="위치 설정"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_setting_home"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/riding_header"
        app:tabGravity="fill"
        app:tabIndicatorColor="#B7E8D2"
        app:tabIndicatorHeight="3dp"
        app:tabIndicatorFullWidth="false"
        app:tabMode="fixed"
        app:tabSelectedTextColor="#26312B"
        app:tabTextAppearance="@style/TextAppearance.Design.Tab"
        app:tabTextColor="#8B918C">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="지도" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="속도계" />
    </com.google.android.material.tabs.TabLayout>

    <FrameLayout
        android:id="@+id/map_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/riding_info_card"
        android:elevation="2dp"
        app:layout_constraintBottom_toTopOf="@+id/speed_pre"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tab_layout">

        <com.kakao.vectormap.MapView
            android:id="@+id/map_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/map_status"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:background="@drawable/riding_info_card"
            android:elevation="6dp"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="카카오맵을 불러오는 중입니다"
            android:textColor="#44514B"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="start|top"
            android:layout_marginStart="18dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/riding_info_card"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/riding_ic_pin" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="라이딩 경로"
                android:textColor="#44514B"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="end|top"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="18dp"
            android:background="@drawable/riding_map_control"
            android:elevation="2dp"
            android:padding="10dp"
            android:src="@drawable/riding_ic_search" />

        <LinearLayout
            android:layout_width="44dp"
            android:layout_height="88dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="18dp"
            android:background="@drawable/riding_info_card"
            android:elevation="2dp"
            android:orientation="vertical">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/riding_map_control"
                android:padding="10dp"
                android:src="@drawable/riding_ic_plus" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E6EBE8" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="43dp"
                android:background="@drawable/riding_map_control"
                android:padding="10dp"
                android:src="@drawable/riding_ic_minus" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/speed_pre"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/riding_info_card"
        android:elevation="4dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        app:layout_constraintBottom_toTopOf="@+id/control_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/riding_ic_flag" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="거리"
                    android:textColor="#55615A"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/m_distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="0.0m"
                android:textColor="#202622"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="42dp"
            android:background="#E7ECE8" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/riding_ic_clock" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="시간"
                    android:textColor="#55615A"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/m_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="00:00:00"
                android:textColor="#202622"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="42dp"
            android:background="#E7ECE8" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/riding_ic_speed" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="속도"
                    android:textColor="#55615A"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/m_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="0.0km/h"
                android:textColor="#202622"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Speedometer tab: gauge, key figures, 2x3 stats. Scrolls on small screens and font scaling. -->
    <ScrollView
        android:id="@+id/speed_tap"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#F7F8F7"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/control_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tab_layout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <!-- Gauge with the current speed in the middle -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.bike.trailgo.ui.riding.RideSpeedGaugeView
                    android:id="@+id/speed_gauge"
                    android:layout_width="match_parent"
                    android:layout_height="216dp"
                    android:layout_gravity="top|center_horizontal" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal|bottom"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="현재 속도"
                        android:textColor="#55615A"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/nowspeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0"
                        android:textColor="#151A17"
                        android:textSize="56sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="km/h"
                        android:textColor="#68716B"
                        android:textSize="16sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Key figures: distance and riding time -->
            <LinearLayout
                android:id="@+id/speedlayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/riding_info_card"
                android:elevation="2dp"
                android:minHeight="92dp"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <LinearLayout style="@style/RideKeyCell">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/riding_ic_flag" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="이동 거리"
                            android:textColor="#55615A"
                            android:textSize="13sp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/dis"
                        style="@style/RideKeyValue"
                        android:text="0 m" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center_vertical"
                    android:background="#E7ECE8" />

                <LinearLayout style="@style/RideKeyCell">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/riding_ic_clock" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="라이딩 시간"
                            android:textColor="#55615A"
                            android:textSize="13sp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/ingtime"
                        style="@style/RideKeyValue"
                        android:text="00:00:00" />
                </LinearLayout>
            </LinearLayout>

            <!-- Stats: 2 rows x 3 columns -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/riding_info_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="72dp"
                    android:orientation="horizontal">

                    <LinearLayout style="@style/RideStatCell">
                        <TextView style="@style/RideStatLabel" android:text="평균 속도" />
                        <TextView android:id="@+id/avgspeed" style="@style/RideStatValue" android:text="-" />
                    </LinearLayout>
                    <View style="@style/RideStatDivider" />
                    <LinearLayout style="@style/RideStatCell">
                        <TextView style="@style/RideStatLabel" android:text="최고 속도" />
                        <TextView android:id="@+id/maxspeed" style="@style/RideStatValue" android:text="-" />
                    </LinearLayout>
                    <View style="@style/RideStatDivider" />
                    <LinearLayout style="@style/RideStatCell">
                        <TextView style="@style/RideStatLabel" android:text="추정 칼로리" />
                        <TextView android:id="@+id/calories" style="@style/RideStatValue" android:text="-" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E7ECE8" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="72dp"
                    android:orientation="horizontal">

                    <LinearLayout style="@style/RideStatCell">
                        <TextView style="@style/RideStatLabel" android:text="현재 고도" />
                        <TextView android:id="@+id/Nowgodo" style="@style/RideStatValue" android:text="-" />
                    </LinearLayout>
                    <View style="@style/RideStatDivider" />
                    <LinearLayout style="@style/RideStatCell">
                        <TextView style="@style/RideStatLabel" android:text="누적 상승" />
                        <TextView android:id="@+id/getgodo" style="@style/RideStatValue" android:text="-" android:textColor="#1F7A2E" />
                    </LinearLayout>
                    <View style="@style/RideStatDivider" />
                    <LinearLayout style="@style/RideStatCell">
                        <TextView style="@style/RideStatLabel" android:text="누적 하강" />
                        <TextView android:id="@+id/total_descent" style="@style/RideStatValue" android:text="-" android:textColor="#2B6D9C" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Followed course (only when riding along a course) -->
            <LinearLayout
                android:id="@+id/flow_info"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/riding_info_card"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/couse_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Course"
                    android:textColor="#1F2622"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Secondary readings -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="경사도 "
                    android:textColor="#677069"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/current_grade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- %"
                    android:textColor="#151A17"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:text="GPS 정확도 "
                    android:textColor="#677069"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/gps_accuracy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="확인 중"
                    android:textColor="#151A17"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Kept for the ride code, not shown -->
            <LinearLayout
                android:id="@+id/status_layout"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/m_t"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00" />

                <TextView
                    android:id="@+id/m_rest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00" />

                <TextView
                    android:id="@+id/resttime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00:00" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom controls: pause/resume and finish side by side, above the system bars -->
    <LinearLayout
        android:id="@+id/control_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="6dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/pausebt"
                style="@style/RideControlButton"
                android:background="@drawable/riding_pause_pill"
                android:onClick="myOnClick"
                android:text="일시정지"
                android:textColor="#26312B"
                app:drawableStartCompat="@drawable/riding_ic_pause" />

            <TextView
                android:id="@+id/resume_bt"
                style="@style/RideControlButton"
                android:background="@drawable/riding_resume_pill"
                android:onClick="myOnClick"
                android:text="다시 시작"
                android:textColor="#FFFFFF"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/riding_ic_play" />
        </FrameLayout>

        <TextView
            android:id="@+id/endriding"
            style="@style/RideControlButton"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/riding_end_pill"
            android:text="종료"
            android:textColor="#D93025" />

        <Spinner
            android:id="@+id/help"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
