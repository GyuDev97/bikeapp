<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/viewClick"
    android:layout_width="match_parent"
    android:layout_height="74dp"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/course_view"
        android:layout_width="72dp"
        android:layout_height="58dp"
        android:background="@drawable/home_map_preview_bg"
        android:scaleType="centerCrop"
        android:src="@drawable/main_img" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView android:id="@+id/c_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="비슬산 임월 코스" android:textColor="#171C18" android:textSize="14sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
            <TextView android:id="@+id/c_dis" style="@style/CourseCompactMeta" android:text="⌖ 22.17 km" />
            <TextView android:id="@+id/c_getgodo" style="@style/CourseCompactMeta" android:text="△ 1,250 m" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/c_avg" android:layout_width="28dp" android:layout_height="wrap_content" android:gravity="end" android:text="상" android:textColor="#376F3A" android:textSize="11sp" android:textStyle="bold" />
    <ImageView android:id="@+id/userimg" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/c_rider_name" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/c_time" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/c_date" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/like_count" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/textView10" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/textView11" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/textView12" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
</LinearLayout>
