    android:orientation="vertical">
    <TextView android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/detail_analysis_icon_bg" android:gravity="center" android:text="▲" android:textColor="#1F7A37" android:textSize="27sp" />
