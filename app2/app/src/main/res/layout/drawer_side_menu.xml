<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_panel"
    android:layout_width="304dp"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="196dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/main_img" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/drawer_header_fade" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp">

            <ImageView
                android:id="@+id/user_image"
                android:layout_width="74dp"
                android:layout_height="74dp"
                android:background="@drawable/drawer_avatar_soft_bg"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/m_logo" />

            <TextView
                android:id="@+id/infouserid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="admin"
                android:textColor="#161919"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/drawer_rider_badge"
                android:layout_width="wrap_content"
                android:layout_height="23dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/drawer_badge_bg"
                android:gravity="center"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:text="TrailGO Rider"
                android:textColor="#2F8C40"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/infousermeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="총 128 km · 라이딩 12회"
                android:textColor="#3D4740"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp">

        <FrameLayout
            android:id="@+id/nav_home"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/drawer_custom_item_bg"
            android:clickable="true"
            android:focusable="true">

            <View
                android:id="@+id/drawer_nav_home_bar"
                android:layout_width="3dp"
                android:layout_height="34dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/drawer_active_bar" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="24dp">

                <ImageView
                    android:layout_width="23dp"
                    android:layout_height="23dp"
                    android:src="@drawable/drawer_ic_home_custom" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:text="홈"
                    android:textColor="#28A745"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/nav_records"
            style="@style/DrawerCustomRow">
            <include layout="@layout/drawer_row_riding" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/nav_course_search"
            style="@style/DrawerCustomRow">
            <include layout="@layout/drawer_row_course" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/nav_danger_view"
            style="@style/DrawerCustomRow">
            <include layout="@layout/drawer_row_danger" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/nav_course_scrap"
            style="@style/DrawerCustomRow">
            <include layout="@layout/drawer_row_saved" />
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="18dp"
            android:background="#ECEFEC" />

        <FrameLayout
            android:id="@+id/nav_sett"
            style="@style/DrawerCustomRow">
            <include layout="@layout/drawer_row_settings" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/nav_help"
            style="@style/DrawerCustomRow">
            <include layout="@layout/drawer_row_help" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/nav_logout"
            style="@style/DrawerCustomRow">
            <include layout="@layout/drawer_row_logout" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/drawer_brand_mark_bg">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_gravity="center"
                    android:src="@drawable/profile_ic_bicycle" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="TrailGO"
                android:textColor="#153A24"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="v 1.0.0"
            android:textColor="#6F7772"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
