<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_panel"
    android:layout_width="286dp"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/drawer_profile_header"
        android:layout_width="match_parent"
        android:layout_height="108dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/drawer_profile_header_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <ImageView
            android:id="@+id/user_image"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/drawer_avatar_soft_bg"
            android:clipToOutline="true"
            android:padding="3dp"
            android:scaleType="centerCrop"
            android:src="@drawable/m_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/infouserid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="이병규"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/infousermeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="내 정보 보기  ›"
                android:textColor="#EAF5E9"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp">

        <TextView
            android:id="@+id/nav_home"
            style="@style/DrawerMenuItem"
            android:drawableStart="@drawable/drawer_ic_home_custom"
            android:text="홈" />

        <TextView
            android:id="@+id/nav_records"
            style="@style/DrawerMenuItem"
            android:drawableStart="@drawable/drawer_ic_record"
            android:text="기록" />

        <TextView
            android:id="@+id/nav_ride"
            style="@style/DrawerMenuItem"
            android:drawableStart="@drawable/profile_ic_bicycle"
            android:text="주행" />

        <TextView
            android:id="@+id/nav_course_search"
            style="@style/DrawerMenuItem"
            android:drawableStart="@drawable/drawer_ic_map_custom"
            android:text="코스" />

        <TextView
            android:id="@+id/nav_course_scrap"
            style="@style/DrawerMenuItem"
            android:drawableStart="@drawable/drawer_ic_bookmark_custom"
            android:text="즐겨찾기" />

        <TextView
            android:id="@+id/nav_badge"
            style="@style/DrawerMenuItem"
            android:drawableStart="@drawable/drawer_ic_badge"
            android:text="배지" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="10dp"
            android:background="#ECEFEC" />

        <TextView
            android:id="@+id/nav_sett"
            style="@style/DrawerMenuItem"
            android:drawableStart="@drawable/drawer_ic_settings_custom"
            android:text="설정" />

        <TextView
            android:id="@+id/nav_help"
            style="@style/DrawerMenuItem"
            android:drawableStart="@drawable/drawer_ic_help_custom"
            android:text="고객센터" />
    </LinearLayout>
</LinearLayout>
