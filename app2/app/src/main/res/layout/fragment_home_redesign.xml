<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:id="@+id/home_header"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/home_menu_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:text="TrailGO"
            android:textColor="#14271B"
            android:textSize="23sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:contentDescription="알림"
            android:padding="10dp"
            android:src="@drawable/ic_bell_home" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/home_bottom_nav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/home_header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:background="@drawable/home_monthly_banner"
                android:clipToOutline="true">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/home_monthly_ride_banner" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="이번 달 라이딩"
                        android:textColor="#263A2C"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/home_month_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="0 회"
                        android:textColor="#111B14"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout style="@style/HomeSummaryStat">
                    <TextView style="@style/HomeSummaryLabel" android:text="총 거리" />
                    <TextView android:id="@+id/main_dis" style="@style/HomeSummaryValue" android:text="0 m" />
                </LinearLayout>
                <View style="@style/HomeSummaryDivider" />
                <LinearLayout style="@style/HomeSummaryStat">
                    <TextView style="@style/HomeSummaryLabel" android:text="총 상승고도" />
                    <TextView android:id="@+id/home_total_height" style="@style/HomeSummaryValue" android:text="0 m" />
                </LinearLayout>
                <View style="@style/HomeSummaryDivider" />
                <LinearLayout style="@style/HomeSummaryStat">
                    <TextView style="@style/HomeSummaryLabel" android:text="총 시간" />
                    <TextView android:id="@+id/home_total_time" style="@style/HomeSummaryValue" android:text="00:00:00" />
                </LinearLayout>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E8EBE8" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/home_recent_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="최근 기록"
                    android:textColor="#161C18"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/home_recent_more"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="전체 보기"
                    android:textColor="#2E7D32"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/home_recent_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView android:id="@+id/main_time" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
            <TextView android:id="@+id/main_km" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
            <TextView android:id="@+id/idinfo" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
            <ProgressBar android:id="@+id/home_goal_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
            <TextView android:id="@+id/home_goal_percent" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/home_bottom_nav"
        layout="@layout/trailgo_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="66dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
