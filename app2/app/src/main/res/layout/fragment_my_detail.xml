<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAF8"
    tools:context=".ui.records.MyDetailFragment">

    <!-- 1. App bar: back, title, share, more -->
    <LinearLayout
        android:id="@+id/detail_top_bar"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/detail_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="뒤로가기"
            android:gravity="center"
            android:text="←"
            android:textColor="#111111"
            android:textSize="22sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="기록 상세"
            android:textColor="#111111"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/detail_share_top"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="공유"
            android:padding="10dp"
            android:src="@drawable/detail_ic_share_dark" />

        <TextView
            android:id="@+id/detail_more"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="더보기"
            android:gravity="center"
            android:text="⋮"
            android:textColor="#111111"
            android:textSize="24sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/detail_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/detail_top_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- 2/3. Title, date and time -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/detail_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="라이딩 기록"
                    android:textColor="#111111"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/records_ic_calendar" />

                    <TextView
                        android:id="@+id/detail_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="-"
                        android:textColor="#444B47"
                        android:textSize="12sp" />

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_marginStart="12dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/riding_ic_clock" />

                    <TextView
                        android:id="@+id/detail_time"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:text="-"
                        android:textColor="#444B47"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/Riding_addr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#6B746E"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 4. Kakao map -->
            <FrameLayout
                android:id="@+id/detail_map_container"
                android:layout_width="match_parent"
                android:layout_height="168dp">

                <ImageView
                    android:id="@+id/detail_map_fallback"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="경로 지도"
                    android:scaleType="fitXY"
                    android:src="@drawable/trailgo_route_preview" />

                <com.kakao.vectormap.MapView
                    android:id="@+id/map_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/detail_map_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="#CCFFFFFF"
                    android:paddingStart="12dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="7dp"
                    android:text="지도를 불러오는 중입니다"
                    android:textColor="#4A534D"
                    android:textSize="11sp" />
            </FrameLayout>

            <!-- 5. Stats: same six values, units and rules as the save screen -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/detail_stats_card_bg"
                android:elevation="2dp"
                android:orientation="vertical"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="62dp"
                    android:orientation="horizontal">

                    <include layout="@layout/detail_stat_distance" />
                    <View android:layout_width="1dp" android:layout_height="42dp" android:layout_gravity="center_vertical" android:background="#E3E8E4" />
                    <include layout="@layout/detail_stat_time" />
                    <View android:layout_width="1dp" android:layout_height="42dp" android:layout_gravity="center_vertical" android:background="#E3E8E4" />
                    <include layout="@layout/detail_stat_rest" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="#E3E8E4" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="62dp"
                    android:orientation="horizontal">

                    <include layout="@layout/detail_stat_avg" />
                    <View android:layout_width="1dp" android:layout_height="42dp" android:layout_gravity="center_vertical" android:background="#E3E8E4" />
                    <include layout="@layout/detail_stat_max" />
                    <View android:layout_width="1dp" android:layout_height="42dp" android:layout_gravity="center_vertical" android:background="#E3E8E4" />
                    <include layout="@layout/detail_stat_height" />
                </LinearLayout>
            </LinearLayout>

            <!-- 6. Elevation graph (real GPX altitude only) -->
            <TextView
                style="@style/DetailSectionTitle"
                android:text="고도 그래프" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/home_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:id="@+id/detail_graph_legend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/detail_graph_high"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#1F7A37"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/detail_graph_low"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:textColor="#1F7A37"
                        android:textSize="10sp" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/detail_elevation_chart_view"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/detail_elevation_empty"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="고도 데이터를 불러오는 중입니다"
                        android:textColor="#7A837D"
                        android:textSize="12sp" />
                </FrameLayout>

                <TextView
                    android:id="@+id/detail_graph_caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="가로축: 이동 거리 · GPS 고도 기준"
                    android:textColor="#9AA39D"
                    android:textSize="9sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 7. Memo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="라이딩 메모"
                    android:textColor="#111111"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/detail_memo_edit"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:contentDescription="메모 수정"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp"
                    android:text="✎ 수정"
                    android:textColor="#169447"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/detail_memo_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/detail_memo_bg"
                android:lineSpacingExtra="3dp"
                android:minHeight="56dp"
                android:padding="14dp"
                android:text="메모를 불러오는 중입니다"
                android:textColor="#4A4033"
                android:textSize="14sp" />

            <!-- 8. Photos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/detail_photo_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="사진"
                    android:textColor="#111111"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/detail_photo_edit"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp"
                    android:text="편집"
                    android:textColor="#169447"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/riding_save_card"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/detail_photo_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="8dp"
                    android:text="저장된 사진이 없습니다."
                    android:textColor="#7A837D"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <com.bike.trailgo.ui.photos.PhotoStripView
                    android:id="@+id/detail_photo_strip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- 9. Weather at the time of the ride: shown only when one was stored -->
            <LinearLayout
                android:id="@+id/detail_weather_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/DetailSectionTitle"
                    android:text="날씨" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/riding_save_card"
                    android:elevation="1dp"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:id="@+id/detail_weather_icon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/records_ic_sun" />

                    <TextView
                        android:id="@+id/detail_weather"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:textColor="#152019"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/detail_weather_note"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#7A837D"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/detail_share_button"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/detail_action_green_bg"
                android:drawableStart="@drawable/detail_ic_share"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:text="공유하기"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detail_gpx_export_button"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/detail_action_outline_bg"
                android:gravity="center"
                android:text="GPX 내보내기"
                android:textColor="#13833F"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/set_open"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/detail_action_outline_bg"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/detail_visibility_public_action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="공개"
                        android:textColor="#13833F"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/set_noopen"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/detail_action_outline_bg"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/detail_visibility_private_action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="비공개"
                        android:textColor="#13833F"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/detail_delete_button"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/detail_action_outline_bg"
                    android:gravity="center"
                    android:text="삭제하기"
                    android:textColor="#E14343"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
