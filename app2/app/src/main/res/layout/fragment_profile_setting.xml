<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/profile_screen_bg"
    android:fillViewport="true"
    tools:context=".setting.Setting">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/profile_title"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:gravity="center"
            android:text="프로필 설정"
            android:textColor="#111111"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/profile_summary_card"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/profile_card_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="12dp">

            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginEnd="16dp">

                <ImageView
                    android:id="@+id/profile_image"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/profile_avatar_bg"
                    android:padding="2dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/m_logo" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="end|bottom"
                    android:background="@drawable/profile_icon_circle"
                    android:padding="5dp"
                    android:src="@drawable/profile_ic_camera" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/profile_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="김철수"
                    android:textColor="#141414"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/profile_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="chulso@email.com"
                    android:textColor="#747474"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:padding="4dp"
                android:src="@drawable/profile_ic_chevron" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="25dp"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:text="계정 정보"
            android:textColor="#686868"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/profile_card_bg"
            android:orientation="vertical">

            <include layout="@layout/profile_row_name" />
            <View style="@style/ProfileDivider" />
            <include layout="@layout/profile_row_email" />
            <View style="@style/ProfileDivider" />
            <include layout="@layout/profile_row_phone" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="25dp"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:text="앱 설정"
            android:textColor="#686868"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/profile_card_bg"
            android:orientation="vertical">

            <include layout="@layout/profile_row_alert" />
            <View style="@style/ProfileDivider" />
            <include layout="@layout/profile_row_privacy" />
            <View style="@style/ProfileDivider" />
            <include layout="@layout/profile_row_theme" />
            <View style="@style/ProfileDivider" />
            <include layout="@layout/profile_row_data" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_help"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/profile_card_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/profile_icon_circle"
                android:padding="7dp"
                android:src="@drawable/profile_ic_help" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="도움 &amp; 문의"
                android:textColor="#202020"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:padding="4dp"
                android:src="@drawable/profile_ic_chevron" />
        </LinearLayout>

        <TextView
            android:id="@+id/row_logout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:drawableStart="@drawable/profile_ic_logout"
            android:drawablePadding="8dp"
            android:gravity="center"
            android:text="로그아웃"
            android:textColor="#D64A4A"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
