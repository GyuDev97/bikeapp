<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:id="@+id/records_header"
        android:layout_width="0dp"
        android:layout_height="62dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/records_menu_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:text="기록"
            android:textColor="#151A17"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:src="@drawable/ic_search_home" />
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:src="@drawable/records_ic_filter"
            android:tint="#202421" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/records_tabs"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/records_header">

        <TextView style="@style/RecordTabActive" android:text="전체" />
        <TextView style="@style/RecordTab" android:text="라이딩" />
        <TextView style="@style/RecordTab" android:text="코스" />
        <TextView style="@style/RecordTab" android:text="즐겨찾기" />
    </LinearLayout>

    <View
        android:id="@+id/records_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#E5E7E5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/records_tabs" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/records_bottom_nav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/records_divider"
        tools:listitem="@layout/myreport_item" />

    <LinearLayout
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone">
        <TextView android:id="@+id/records_count_text" android:layout_width="1dp" android:layout_height="1dp" />
        <TextView android:id="@+id/records_total_distance" android:layout_width="1dp" android:layout_height="1dp" />
        <TextView android:id="@+id/records_total_height" android:layout_width="1dp" android:layout_height="1dp" />
        <TextView android:id="@+id/records_total_time" android:layout_width="1dp" android:layout_height="1dp" />
    </LinearLayout>

    <include
        android:id="@+id/records_bottom_nav"
        layout="@layout/trailgo_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="66dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
