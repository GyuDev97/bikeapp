<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="76dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">
    <ImageView
        android:layout_width="76dp"
        android:layout_height="54dp"
        android:background="@drawable/home_map_preview_bg"
        android:scaleType="centerCrop"
        android:src="@drawable/trailgo_route_preview" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="금호강 라이딩" android:textColor="#172019" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="9.84 km    △ 120 m    ◷ 1:12:48" android:textColor="#69716C" android:textSize="10sp" />
    </LinearLayout>
