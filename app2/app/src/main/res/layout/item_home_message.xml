<?xml version="1.0" encoding="utf-8"?>
<!-- Empty / loading / error state of the recent rides list. Never filled with sample rides. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/home_stat_card_bg"
    android:gravity="center_horizontal"
    android:minHeight="92dp"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/home_message_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#172019"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/home_message_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center"
        android:textColor="#55615A"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/home_message_retry"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minWidth="96dp"
        android:text="다시 시도"
        android:textColor="#1F7A2E"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
