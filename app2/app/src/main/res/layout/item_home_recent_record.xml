<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_recent_item"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="48dp"
        android:background="@drawable/home_map_preview_bg"
        android:scaleType="centerCrop"
        android:src="@drawable/trailgo_route_preview" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/home_recent_item_course"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#172019"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/home_recent_item_distance"
                style="@style/HomeRecordMeta" />

            <TextView
                android:id="@+id/home_recent_item_height"
                style="@style/HomeRecordMeta" />

            <TextView
                android:id="@+id/home_recent_item_duration"
                style="@style/HomeRecordMeta" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/home_recent_item_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:maxWidth="64dp"
        android:textColor="#8D938E"
        android:textSize="10sp" />
</LinearLayout>
