<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/viewClick"
    android:layout_width="match_parent"
    android:layout_height="104dp"
    android:background="#FFFFFF"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">

    <TextView
        android:id="@+id/record_date"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:gravity="center_vertical"
        android:text="2026.05.16 (금)"
        android:textColor="#5C625E"
        android:textSize="10sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/myimage"
            android:layout_width="82dp"
            android:layout_height="58dp"
            android:background="@drawable/home_map_preview_bg"
            android:scaleType="centerCrop"
            android:src="@drawable/trailgo_route_preview" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/record_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="대구 앞산 라이딩"
                android:textColor="#151A17"
                android:textSize="14sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView android:id="@+id/my_dis" style="@style/RecordListMeta" android:text="⌖ 12.45 km" />
                <TextView android:id="@+id/my_get" style="@style/RecordListMeta" android:text="△ 45 m" />
                <TextView android:id="@+id/my_time" style="@style/RecordListMeta" android:text="◷ 1:45:32" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/record_time" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <ImageView android:id="@+id/record_weather_icon" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/record_adress" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <ImageView android:id="@+id/record_bookmark_icon" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/record_recent_label" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" tools:visibility="gone" />
    <TextView android:id="@+id/record_section_label" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" tools:visibility="gone" />
</LinearLayout>
