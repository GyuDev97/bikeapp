<resources>
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="TrailGoAuthTheme" parent="AppTheme.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="colorAccent">#168A45</item>
    </style>


    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="HomeBottomNavItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#303A34</item>
        <item name="android:textSize">11sp</item>
        <item name="android:drawablePadding">2dp</item>
    </style>

    <style name="HomeSummaryStat">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="HomeSummaryLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#818983</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="HomeSummaryValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#152019</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="HomeSummaryDivider">
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:background">#E7EBE7</item>
    </style>

    <style name="HomeRecordMeta">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">14dp</item>
        <item name="android:textColor">#667069</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="HomeNavLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">#667069</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="HomeNavLabelActive" parent="HomeNavLabel">
        <item name="android:textColor">#2E7D32</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="HomeActionRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">#1F2822</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:drawablePadding">8dp</item>
    </style>

    <style name="ProfileDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">54dp</item>
        <item name="android:background">#EEF0EC</item>
    </style>

    <style name="DrawerCustomRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/drawer_custom_item_bg</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="TrailGoSplashTheme" parent="AppTheme.NoActionBar">
        <item name="android:windowBackground">#F8F6EF</item>
        <item name="android:statusBarColor">#F8F6EF</item>
        <item name="android:navigationBarColor">#173A27</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="DrawerMenuItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginTop">1dp</item>
        <item name="android:background">@drawable/drawer_custom_item_bg</item>
        <item name="android:clickable">true</item>
        <item name="android:drawablePadding">18dp</item>
        <item name="android:drawableTint">@color/drawer_menu_item_color</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/drawer_menu_item_color</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DetailStatCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">58dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="DetailPhotoThumb">
        <item name="android:layout_width">129dp</item>
        <item name="android:layout_height">81dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/detail_photo_bg</item>
        <item name="android:scaleType">centerCrop</item>
    </style>

    <style name="CourseFilterTab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#667069</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="CourseFilterTabActive" parent="CourseFilterTab">
        <item name="android:background">@drawable/course_badge_bg</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CourseStatCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="CourseStatLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#858C87</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="CourseStatValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#172019</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CourseStatDivider">
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:background">#E8ECE7</item>
    </style>

    <style name="TrailGoBottomNavItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/trailgo_nav_item_bg</item>
        <item name="android:clickable">true</item>
        <item name="android:drawablePadding">2dp</item>
        <item name="android:drawableTint">@color/trailgo_nav_item</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textColor">@color/trailgo_nav_item</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="RecordTab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#555B57</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="RecordTabActive" parent="RecordTab">
        <item name="android:background">@drawable/trailgo_chip_active</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="RecordListMeta">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">14dp</item>
        <item name="android:textColor">#4E5751</item>
        <item name="android:textSize">10sp</item>
    </style>
    <style name="CourseCompactMeta">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:textColor">#646B67</item>
